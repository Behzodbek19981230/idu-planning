# Serverda: cp .env.production.example .env  va qiymatlarni to'ldiring
NODE_ENV=production
PORT=4000
HOST=127.0.0.1

# PostgreSQL (DEPLOY.md 3-qadamda yaratiladi)
DATABASE_URL="postgresql://idu:PAROL_BU_YERGA@localhost:5432/idu_planning?schema=public"

# Har biri uchun: openssl rand -base64 48
JWT_SECRET=
# Boshlang'ich parollarni shifrlash kaliti. O'zgartirilsa, saqlangan parollar o'qilmay qoladi!
PASSWORD_SECRET=

# Frontend domeni (CORS)
CORS_ORIGIN=https://idu-schedule.universal-uz.uz
# Frontendni nginx beradi
SERVE_CLIENT=false

# Birinchi ishga tushishda yaratiladigan admin (keyin Profil'dan parolni o'zgartirish mumkin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator
